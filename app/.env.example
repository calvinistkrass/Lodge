# Adresse des Lodge-Servers (Socket.IO + API). Ohne Angabe: http://localhost:3000
EXPO_PUBLIC_SERVER_URL=https://api.deinedomain.de

# Adresse der Web-App, auf die Einladungslinks zeigen (z. B. deine Vercel-Domain)
EXPO_PUBLIC_WEB_URL=https://lodge.deinedomain.de

# Optional: eigene Download-Adresse für die PC-Version (Standard: neuestes GitHub-Release)
# EXPO_PUBLIC_DOWNLOAD_URL=https://example.com/Lodge-Setup.exe
